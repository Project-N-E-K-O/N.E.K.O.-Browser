{
  "manifest_version": 3,
  "name": "N.E.K.O Floating WebUI",
  "description": "Show the local N.E.K.O WebUI as a floating panel, fullscreen overlay, or native browser side panel.",
  "version": "0.2.0",
  "minimum_chrome_version": "142",
  "action": {
    "default_title": "Toggle N.E.K.O Floating WebUI",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http: https:; frame-src http: https:;"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "storage",
    "offscreen",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:48911/*",
    "http://127.0.0.1:48911/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "css": [
        "transparent-page.css",
        "embedded-surface.css"
      ],
      "js": [
        "transparent-page.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "transparent-main-world.js",
        "embedded-surface-main-world.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "transparent-page.css",
        "transparent-main-world.js",
        "floating-frame.html",
        "assets/cat-idle-cat1.gif"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
