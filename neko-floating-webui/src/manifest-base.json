{
  "name": "N.E.K.O Floating WebUI + BrowserSkill",
  "description": "Show N.E.K.O in a floating, fullscreen, or side-panel surface and connect local AI agents through BrowserSkill.",
  "version": "0.3.0",
  "minimum_chrome_version": "142",
  "icons": {
    "16": "assets/ui/icon_systray_16.png",
    "32": "assets/ui/icon_systray_32.png",
    "48": "assets/ui/icon_systray_48.png",
    "128": "assets/ui/icon_systray_128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/ui/icon_systray_16.png",
      "32": "assets/ui/icon_systray_32.png",
      "48": "assets/ui/icon_systray_48.png",
      "128": "assets/ui/icon_systray_128.png"
    },
    "default_title": "N.E.K.O / BrowserSkill",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http: https: ws://127.0.0.1:52800; frame-src http: https:;"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "debugger",
    "idle",
    "notifications",
    "offscreen",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "webNavigation",
    "windows"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "css": ["transparent-page.css", "embedded-surface.css"],
      "js": ["transparent-page.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["transparent-main-world.js", "embedded-surface-main-world.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "transparent-page.css",
        "transparent-main-world.js",
        "floating-frame.html",
        "assets/cat-idle-cat1.gif"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
