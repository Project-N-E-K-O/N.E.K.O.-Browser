{
  "name": "neko-floating-webui-extension",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/ensure-browser-skill.cjs && wxt",
    "build": "node scripts/ensure-browser-skill.cjs && wxt build",
    "compile": "node scripts/ensure-browser-skill.cjs && wxt prepare && pnpm check:runtime && tsc --noEmit",
    "check:runtime": "node scripts/check-runtime-js.cjs",
    "test": "pnpm check:runtime && pnpm test:neko && pnpm test:integration",
    "test:neko": "node tests/test-neko.cjs",
    "test:integration": "node scripts/ensure-browser-skill.cjs && vitest run",
    "postinstall": "node scripts/ensure-browser-skill.cjs && wxt prepare"
  },
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "i18next": "^24.2.2",
    "i18next-browser-languagedetector": "^8.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.3.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.6",
    "wxt": "^0.20.0"
  }
}
