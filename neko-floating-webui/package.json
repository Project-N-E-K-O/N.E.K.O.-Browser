{
  "name": "neko-floating-webui-extension",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "compile": "wxt prepare && tsc --noEmit",
